# Copy to .env and fill in. NEVER commit real values.

# --- CORS (comma-separated origins; include your Vercel URLs in production) ---
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:8000,http://localhost:9000

# --- Secrets (generate with: openssl rand -base64 48) ---
JWT_SECRET=<generate-a-strong-random-value>
COOKIE_SECRET=<generate-a-strong-random-value>

# --- Database (use the Neon POOLED connection string in production) ---
DATABASE_URL=
# Neon DIRECT (non-pooled) connection string — used only by `db:migrate:prod`
# (Railway preDeployCommand). PgBouncer transaction pooling breaks DDL/advisory
# locks during migrations. Falls back to DATABASE_URL if unset.
# DATABASE_URL_DIRECT=
DB_NAME=medusa-backend
# Set to "false" only for a non-SSL Postgres (local dev DB or CI). Default: SSL on (Neon/prod).
# DATABASE_SSL=false

# --- Optional: Redis (required when running >1 instance on Railway/Cloud Run) ---
# REDIS_URL=redis://localhost:6379

# --- Optional: worker split on Railway ("shared" | "server" | "worker") ---
# MEDUSA_WORKER_MODE=shared

# --- Cloudinary (required in production; local disk is ephemeral on Railway) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Stripe (see docs/STRIPE_SETUP.md; sk_test_* = sandbox, sk_live_* = real money) ---
# STRIPE_API_KEY=sk_test_...
# Webhook signing secret from the Stripe dashboard endpoint:
#   {backend-url}/hooks/payment/stripe_stripe
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- SendGrid (required in production for transactional emails) ---
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# SendGrid dynamic template IDs (create in SendGrid UI; HTML in docs/STRIPE_SETUP.md)
# SENDGRID_ORDER_PLACED_TEMPLATE_ID=d-...
# SENDGRID_ORDER_SHIPPED_TEMPLATE_ID=d-...
# Optional separate template for the admin alert (falls back to order-placed template)
# SENDGRID_ADMIN_NEW_ORDER_TEMPLATE_ID=d-...
# Where "new order" alerts are sent (the client's inbox)
# ADMIN_NOTIFICATION_EMAIL=

# --- Invoices ---
# Absolute path to a logo image rendered at the top of order invoice PDFs.
# Unset (the default) prints the "Mithra Whole Foods" wordmark instead. The
# deployed image only contains .medusa/server, so point this at a file that
# actually ships with the container if you want the image.
# INVOICE_LOGO_PATH=

# --- Storefront URL (used by admin homepage preview iframe + cache revalidation) ---
STOREFRONT_URL=http://localhost:8000
# Secret shared with the storefront's /api/revalidate endpoint
REVALIDATE_SECRET=<generate-a-strong-random-value>

# --- Content Studio (client-facing product content intake) ---
# Unlisted page at GET /content-studio?t=<token> where the client writes the
# copy for each product's image carousel and uploads reference photos. There
# are no accounts: possession of the link IS the credential, so make this long
# and random (32+ chars) and send it over a channel you trust. Rotating it
# instantly invalidates every link already sent. Unset = the page returns 503
# and the whole feature is inert. Uploads reuse the configured file provider
# (Cloudinary in production).
# CONTENT_STUDIO_TOKEN=<generate-a-long-random-value>

# ============================================================================
# Observability & analytics — all OPTIONAL, all inert when unset
# ============================================================================

# --- Sentry (error tracking) ---
# SENTRY_DSN=

# --- PostHog (authoritative server-side revenue events from order.placed) ---
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# --- Internal infrastructure dashboard (Admin → Infrastructure) ---
# Encrypts platform API tokens entered in the admin UI. Falls back to
# COOKIE_SECRET/JWT_SECRET if unset — only set this if you want to rotate
# session secrets without re-entering every vendor token.
# PLATFORM_MONITOR_SECRET=<generate-a-strong-random-value>
# Slack incoming webhook URL for budget/limit alerts (recommended — works with
# no other setup, unlike email which needs SENDGRID_API_KEY).
# PLATFORM_ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# Email address for alert digests, sent via SendGrid when SENDGRID_API_KEY is
# set. Falls back to ADMIN_NOTIFICATION_EMAIL.
# PLATFORM_ALERT_EMAIL=
# Optional dynamic template id for the alert email; falls back to plain text.
# SENDGRID_PLATFORM_ALERT_TEMPLATE_ID=d-...
# Read-only credentials for each platform can also be entered directly in the
# admin UI (Admin → Infrastructure → Connections) instead of here.
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# RAILWAY_API_TOKEN=
# RAILWAY_PROJECT_ID=
# NEON_API_KEY=
# NEON_PROJECT_ID=

# --- Per-shopper rate limiting ---
# Shared secret that lets the storefront forward the real shopper IP, so
# /store/* is limited per shopper rather than per storefront. Must be
# IDENTICAL to the storefront's STOREFRONT_PROXY_SECRET. When unset, the
# limiter falls back to plain IP keying (the previous behaviour), so this is
# safe to roll out to either side first.
# STOREFRONT_PROXY_SECRET=<generate-a-strong-random-value; must match storefront>

# --- FedEx (for tracking and webhooks) ---
# FEDEX_API_KEY=
# FEDEX_SECRET_KEY=
# FEDEX_WEBHOOK_SECRET=

# --- Easyship Multi-Carrier Fulfillment (UPS, FedEx, USPS, etc.) ---
# EASYSHIP_API_KEY=
# EASYSHIP_WEBHOOK_SECRET=
# SHIP_FROM_ZIP=19341
# SHIP_FROM_CITY=Exton
# SHIP_FROM_STATE=PA
# SHIP_FROM_COUNTRY=US
# SHIP_FROM_ADDRESS="Mithra Whole Foods"
